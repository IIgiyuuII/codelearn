

# --- PostgreSQL ---
DB_HOST=localhost
# 5432 — если используете свой установленный PostgreSQL,
# 5433 — если поднимаете базу через docker compose (чтобы не конфликтовать с локальным)
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=поставьте_свой_пароль
DB_NAME=CodeLearn

# --- Бэкенд ---
# Обязательно. Длинная случайная строка (команда для генерации — в README).
JWT_SECRET=
PORT=4000
CORS_ORIGIN=http://localhost:3000
