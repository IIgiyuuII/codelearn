# Скопируйте в .env (Copy-Item .env.example .env) и подставьте свои значения.
# Файл .env не коммитится (см. .gitignore). Комментарии — только на отдельных строках.

# --- PostgreSQL ---
DB_HOST=localhost
# 5432 — если используете свой установленный PostgreSQL,
# 5433 — если поднимаете базу через docker compose (чтобы не конфликтовать с локальным)
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=поставьте_свой_пароль
DB_NAME=CodeLearn

# --- Бэкенд ---
# Обязательно. Длинная случайная строка (команда для генерации — в README).
JWT_SECRET=
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Подсказки ИИ (DeepSeek) ---
# Ключ берётся на https://platform.deepseek.com/api_keys. Без ключа подсказки просто отключены:
# кнопка не показывается, остальное приложение работает как обычно. Ключ хранится ТОЛЬКО на сервере.
DEEPSEEK_API_KEY=

# Необязательные настройки (значения по умолчанию указаны справа от «=»):
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# HINTS_ENABLED=true
# Пауза между подсказками одного пользователя, секунды
# HINTS_COOLDOWN_SECONDS=15
# Не более подсказок на одну задачу / в час на пользователя / в сутки на весь сервер
# HINTS_MAX_PER_TASK=8
# HINTS_PER_USER_PER_HOUR=15
# HINTS_DAILY_LIMIT=1000
# HINTS_TIMEOUT_SECONDS=30
# HINTS_MAX_TOKENS=500
